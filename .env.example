# Copie para .env e preencha. Nunca commite o .env.

# ── Postgres (docker compose) ─────────────────────────────────────────────
# Usuário/banco padrão do compose: commerce / commerce
POSTGRES_PASSWORD=

# Conexão da aplicação (dono do schema)
# formato: postgres://commerce:<POSTGRES_PASSWORD>@localhost:5466/commerce
DATABASE_URL=

# Conexão do agente para leitura. Usuário OBRIGATÓRIO: agent_readonly (senha à sua escolha;
# o `pnpm db:migrate` cria a role com ela)
# formato: postgres://agent_readonly:<senha>@localhost:5466/commerce
READONLY_DATABASE_URL=

# Testes de integração (banco commerce_test, criado pelo init do container)
# formato: igual aos anteriores, trocando o banco para commerce_test
TEST_DATABASE_URL=
TEST_READONLY_DATABASE_URL=

# ── LLM ───────────────────────────────────────────────────────────────────
# Chave do provider escolhido (lida pelo Mastra, nunca exposta ao modelo)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Opcional: model router do Mastra, "<provider>/<model>" (padrão: anthropic/claude-sonnet-5)
# MASTRA_MODEL=
# Opcional: gateway compatível com a API da Anthropic
# ANTHROPIC_BASE_URL=

# ── Opcionais (defaults no código) ────────────────────────────────────────
# QUERY_TIMEOUT_MS=      # padrão 5000
# QUERY_MAX_ROWS=        # padrão 200
# APP_TIMEZONE=          # padrão America/Sao_Paulo
# MCP_OPERATOR_ID=       # padrão carla (viewer), usado por `pnpm mcp`
