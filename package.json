{
  "name": "mastra-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3466",
    "dev:mastra": "PORT=4466 mastra dev",
    "build": "next build",
    "build:mastra": "mastra build",
    "start": "next start -p 3466",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed && pnpm db:migrate --test",
    "mcp": "tsx src/mastra/mcp/stdio.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.119",
    "@mastra/ai-sdk": "^1.10.5",
    "@mastra/core": "^1.71.0",
    "@mastra/loggers": "^1.3.2",
    "@mastra/mcp": "^2.1.0",
    "@mastra/memory": "^1.32.1",
    "@mastra/observability": "^1.18.1",
    "@mastra/pg": "^1.27.1",
    "ai": "^7.0.116",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "mastra": "^1.31.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.4.1"
}
